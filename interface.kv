MDScreen:
    MDBoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "15dp"

        MDLabel:
            text: "Cliente Modbus TCP - KivyMD"
            font_style: "H5"
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1]

        MDBoxLayout:
            spacing: "10dp"
            size_hint_y: None
            height: "50dp"

            MDTextField:
                id: input_ip
                hint_text: "IP do Servidor"
                text: "127.0.0.1"

            MDTextField:
                id: input_porta
                hint_text: "Porta"
                text: "502"
                input_filter: "int"

            MDRaisedButton:
                id: btn_conectar
                text: "Conectar"
                on_release: app.conectar()

        MDBoxLayout:
            spacing: "10dp"
            size_hint_y: None
            height: "50dp"
            